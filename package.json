{
  "name": "agentic-patterns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "web:api": "tsx --env-file=.env src/server/index.ts",
    "web:app": "npm --prefix web start",
    "web:test": "npm --prefix web test -- --watch=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm test && npm run web:test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.12"
  }
}
